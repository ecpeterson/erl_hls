fn dispatch_internal(event: u8, phase: Phase, data: State) -> (Phase, State, Directive, u1, hls_failure::Code, u8, u64, axis::Frame, bool) {
  match (event, phase) {
    _ => (phase, data, Directive::FAIL, u1:0, hls_failure::INVALID_MESSAGE, u8:0, u64:0, zero!<axis::Frame>(), true),
  }
}

fn actor_next_event(machine: ActorState) -> ActorDispatch {
  let (phase, data, directive, repeat_phase, callback_failure, next_event, reply_from, reply_frame, reply_allowed) =
    dispatch_internal(machine.next_event, machine.phase, machine.data);
  let invalid = directive == Directive::POSTPONE ||
    (repeat_phase && (directive != Directive::CONSUME || phase != machine.phase));
  let boundary = phase != machine.phase || repeat_phase;
  let incomplete = false;
  let effective = !invalid && !incomplete;
  let failure = hls_failure::dispatch(false, invalid, incomplete, effective, callback_failure);
  let (reply_book, response, response_valid) = complete_reply(
    machine.replies, reply_from, reply_frame, reply_allowed, failure as u32);
  let contract_fault = failure == hls_failure::NONE && reply_book.failure == hls_failure::source_error(hls_failure::REPLY_CONTRACT);
  let failure = hls_failure::first(failure, if reply_book.failure != u32:0 { hls_failure::REPLY_CONTRACT } else { hls_failure::NONE });
  let failed = hls_failure::failed(failure);
  ActorDispatch {
    machine: ActorState {
      phase: if effective && !contract_fault { phase } else { machine.phase },
      entered_from: if effective && boundary { machine.phase } else { machine.entered_from },
      data: if effective && !contract_fault { data } else { machine.data },
      replies: reply_book,
      next_event: if effective && !failed { next_event } else { u8:0 },
      enter_pending: effective && boundary && !failed, failure, ..machine
    },
    phase_boundary: effective && boundary && !failed,
    reply: response, reply_valid: response_valid,
    ..zero!<ActorDispatch>()
  }
}

type MailboxSlot = direct_mailbox_observation::Slot;

struct Machine {
  phase: Phase,
  entered_from: Phase,
  data: State,
  slots: MailboxSlot[1],
  occupied: u8,
  replies: ReplyBook,
  next_event: u8,
  enter_pending: u1,
  entry_effect_index: u8,
  // Reserves one queue slot for the frame being assembled.
  admission_pending: u1,
  // A failed service ignores input until reset.
  failure: hls_failure::Code,
}

struct MachineStep {
  machine: Machine,
  egress: Egress,
  egress_valid: u1,
  admission_valid: u1,
}

fn initial_machine() -> Machine {
  let machine = initial_actor_state();
  Machine { phase: machine.phase, entered_from: machine.entered_from, data: machine.data,
    replies: machine.replies,
    next_event: machine.next_event,
    enter_pending: machine.enter_pending, failure: machine.failure, ..zero!<Machine>() }
}

fn actor_state(machine: Machine) -> ActorState {
  ActorState {
    phase: machine.phase,
    entered_from: machine.entered_from,
    data: machine.data,
    replies: machine.replies,
    next_event: machine.next_event,
    enter_pending: machine.enter_pending,
    failure: machine.failure,
  }
}

fn machine_step(
    machine: Machine, frame: axis::Frame, received: u1,
    egress_ready: u1) -> MachineStep {
  if hls_failure::failed(machine.failure) {
    let admitted_slots = if received { update(machine.slots, machine.occupied as u32, MailboxSlot { frame, ..zero!<MailboxSlot>() }) } else { machine.slots };
    let occupied = machine.occupied + received as u8;
    let step = actor_reply_failure(actor_state(machine), admitted_slots[u32:0].frame, occupied != u8:0);
    let commit = !step.reply_valid || egress_ready;
    let consume = step.dispatched && commit;
    let remaining = occupied - consume as u8;
    let slots = unroll_for! (i, slots): (u32, MailboxSlot[MAILBOX_DEPTH]) in u32:0..MAILBOX_DEPTH {
      update(slots, i, if consume && i + u32:1 < occupied as u32 { admitted_slots[i + u32:1] } else { admitted_slots[i] })
    }(admitted_slots);
    let pending = machine.admission_pending && !received;
    let reserve = !pending && !received && remaining < MAILBOX_CAPACITY;
    MachineStep { machine: Machine { replies: if commit { step.machine.replies } else { machine.replies },
        occupied: remaining, slots, next_event: u8:0, enter_pending: false, admission_pending: pending || reserve, ..machine },
      egress: Egress { port: OutputPort::REPLY, frame: step.reply },
      egress_valid: step.reply_valid && commit, admission_valid: reserve, ..zero!<MachineStep>() }
  } else if machine.enter_pending {
    let outcome = enter(
      machine.entered_from, machine.phase, machine.data);
    let effects = outcome.effects;
    let effect_count = entry_effect_count(effects);
    let has_effect = machine.entry_effect_index < effect_count;
    let effect = entry_effect(
      effects, machine.entry_effect_index);
    let entry_failure = outcome.failure;
    let entry_failed = hls_failure::failed(entry_failure);
    let can_advance = !entry_failed && (!has_effect || egress_ready);
    let next_effect_index = machine.entry_effect_index +
      ((has_effect && can_advance) as u8);
    let entry_complete = can_advance &&
      next_effect_index >= effect_count;
    let reserve = entry_complete &&
      !machine.admission_pending &&
      machine.occupied < MAILBOX_CAPACITY;
    let advanced_machine = Machine {
      data: if entry_complete { outcome.data } else { machine.data },
      enter_pending: !entry_complete && !entry_failed,
      entry_effect_index: if entry_complete {
        u8:0
      } else { next_effect_index },
      admission_pending: machine.admission_pending || reserve,
      failure: entry_failure,
      ..machine
    };
    MachineStep {
      machine: if can_advance || entry_failed { advanced_machine }
        else { machine },
      egress: effect,
      egress_valid: has_effect && can_advance,
      admission_valid: reserve,
    }
  } else if machine.next_event != u8:0 {    let step = actor_next_event(actor_state(machine));
    let step = if step.reply_valid && !egress_ready { ActorDispatch { machine: actor_state(machine), ..zero!<ActorDispatch>() } } else { step };
    let slots = unroll_for! (i, slots): (u32, MailboxSlot[MAILBOX_DEPTH]) in u32:0..MAILBOX_DEPTH {
      update(slots, i, MailboxSlot {
        postponed: if step.phase_boundary { false } else { slots[i].postponed }, ..slots[i]
      })
    }(machine.slots);
    MachineStep {
      machine: Machine {
        phase: step.machine.phase, entered_from: step.machine.entered_from,
        data: step.machine.data, next_event: step.machine.next_event,
        enter_pending: step.machine.enter_pending, failure: step.machine.failure,        replies: step.machine.replies,
        slots, ..machine
      },      egress: Egress { port: OutputPort::REPLY, frame: step.reply }, egress_valid: step.reply_valid,
      ..zero!<MachineStep>()
    }  } else {
      let tag_ok = true;
      let accepted = received && tag_ok;
      let invalid_input = received && !tag_ok;
      let incoming_slot = MailboxSlot {
        frame,
        ..zero!<MailboxSlot>()
      };
      let admitted_slots = if accepted {
        update(machine.slots, machine.occupied as u32, incoming_slot)
      } else { machine.slots };
      let admitted_occupied = machine.occupied + (accepted as u8);
      let eligible_0 = u8:0 < admitted_occupied &&
        !admitted_slots[0].postponed;
      let found = eligible_0;
      let selected = {
        let selected_1 = u8:0;
        let selected_0 = if eligible_0 { u8:0 } else { selected_1 };
        selected_0
      };
      let selected_frame = admitted_slots[selected as u32].frame;
      let dispatchable = found && !invalid_input;
    let (admitted_replies, call_from, call_error) = if dispatchable && request_error(selected_frame) != u32:0 { (machine.replies, u64:0, request_error(selected_frame)) } else if dispatchable && is_call(selected_frame.header.op) { hls_reply::immediate_admit(machine.replies, selected_frame) } else { (machine.replies, u64:0, u32:0) };
      let (next_phase, next_data, directive, repeat_phase, dispatch_failure, next_event, reply_from, reply_frame, reply_allowed) =
        if dispatchable {
          dispatch(selected_frame, machine.phase, machine.data, call_from, call_error)
        } else {
          (machine.phase, machine.data, Directive::CONSUME, u1:0, hls_failure::NONE, u8:0, u64:0, zero!<axis::Frame>(), true)
        };
      let invalid_repeat = (dispatchable && is_call(selected_frame.header.op) && directive == Directive::POSTPONE) || dispatchable && repeat_phase &&
        (directive != Directive::CONSUME ||
         next_phase != machine.phase);
      let effective = dispatchable && !invalid_repeat;
      let selected_slot = admitted_slots[selected as u32];
      let postponed_slot = MailboxSlot {
        postponed: u1:1,
        ..selected_slot
      };
      let postponed_slots = update(
        admitted_slots, selected as u32, postponed_slot);
      let compacted_0 = zero!<MailboxSlot>();
      let compacted_slots = [compacted_0];
      let transition_slots = match directive {
        Directive::CONSUME => compacted_slots,
        Directive::POSTPONE => postponed_slots,
        Directive::FAIL => admitted_slots,
      };
      let candidate_slots = if effective {
        transition_slots
      } else { admitted_slots };
      let candidate_occupied = if effective &&
          directive == Directive::CONSUME {
        admitted_occupied - u8:1
      } else { admitted_occupied };
      let candidate_phase = if effective {
        next_phase
      } else { machine.phase };
      let candidate_data = if effective {
        next_data
      } else { machine.data };
      let phase_changed = candidate_phase != machine.phase;
      let phase_boundary = phase_changed ||
        (effective && repeat_phase);
      let unblocked_slots = [MailboxSlot { postponed: u1:0, ..candidate_slots[0] }];
      let final_slots = if phase_boundary {
        unblocked_slots
      } else { candidate_slots };
      let failure = hls_failure::dispatch(invalid_input, invalid_repeat, false, effective, dispatch_failure);
      let failed = hls_failure::failed(failure);
    let (reply_book, response, response_valid) = finish_reply(admitted_replies, selected_frame, call_error, reply_from, reply_frame, reply_allowed, failure);
    let contract_fault = failure == hls_failure::NONE && reply_book.failure == hls_failure::source_error(hls_failure::REPLY_CONTRACT);
    let failure = hls_failure::first(failure, if reply_book.failure != u32:0 { hls_failure::REPLY_CONTRACT } else { hls_failure::NONE });
    let failed = hls_failure::failed(failure);
      let admission_pending =
        machine.admission_pending && !received;
      // Preserve occupied + admission_pending <= capacity.
      let reserve = !failed && !received && !admission_pending &&
        candidate_occupied < MAILBOX_CAPACITY;
      let next_machine = Machine {
        phase: if contract_fault { machine.phase } else { candidate_phase },
        entered_from: if phase_boundary {
          machine.phase
        } else { machine.entered_from },
        data: if contract_fault { machine.data } else { candidate_data },
        replies: reply_book,
        next_event: if effective && !failed { next_event } else { u8:0 },
        slots: if failed && dispatchable { compacted_slots } else { final_slots },
        occupied: if failed && dispatchable { admitted_occupied - u8:1 } else { candidate_occupied },
        enter_pending: effective && phase_boundary && !failed,
        admission_pending: admission_pending || reserve,
        failure,
        ..machine
      };
      if response_valid && !egress_ready {
        MachineStep { machine: Machine { slots: admitted_slots, occupied: admitted_occupied,
          admission_pending: machine.admission_pending && !received, ..machine }, ..zero!<MachineStep>() }
      } else {
      MachineStep {
        machine: next_machine,
        admission_valid: reserve,
      egress: Egress { port: OutputPort::REPLY, frame: response }, egress_valid: response_valid,
        ..zero!<MachineStep>()
      }
      }
  }
}

pub proc Service {
  req_in: chan<axis::Frame> in;
  egress_out: chan<Egress> out;
  admission_out: chan<u1> out;

  config(req_in: chan<axis::Frame> in,
         egress_out: chan<Egress> out,
         admission_out: chan<u1> out) {
    (req_in, egress_out, admission_out)
  }

  init { (initial_machine(), u1:0) }

  next(state: (Machine, u1)) {
    let (machine, admission_valid) = state;
    // Reserve capacity in machine_step, then publish its credit
    // from registered state to break receive/admission feedback.
    // Its token is independent of the current receive and egress.
    let _admission_tok = send_if(
      join(), admission_out, admission_valid, u1:1);
    let receive_enabled = machine.admission_pending && (hls_failure::failed(machine.failure) || (!machine.enter_pending && machine.next_event == u8:0));
    let (tok, frame, received) = recv_if_non_blocking(
      join(), req_in, receive_enabled, zero!<axis::Frame>());
    let stepped = machine_step(machine, frame, received, u1:1);
    let _egress_tok = send_if(
      tok, egress_out, stepped.egress_valid, stepped.egress);
    (stepped.machine, stepped.admission_valid)
  }
}

proc EgressDemux {
  egress_in: chan<Egress> in;
  reply_out: chan<axis::Frame> out;

  config(egress_in: chan<Egress> in,
         reply_out: chan<axis::Frame> out
  ) {
    (egress_in, reply_out)
  }

  init { () }

  next(state: ()) {
    let (tok, egress) = recv(join(), egress_in);
    let _send_tok = match egress.port {
      OutputPort::REPLY =>
        send(tok, reply_out, egress.frame),
    };
    state
  }
}

pub proc Top {
  ext_recv: chan<axis::Beat> in;
  ext_send: chan<axis::Beat> out;

  config(ext_recv: chan<axis::Beat> in,
         ext_send: chan<axis::Beat> out) {
    let (req_p, req_c) = chan<axis::Frame, u32:1>("req");
    let (admit_p, admit_c) = chan<u1, u32:1>("admit");
    let (egress_p, egress_c) =
      chan<Egress, EGRESS_DEPTH>("egress");
    let (reply_p, reply_c) = chan<axis::Frame, u32:1>("reply");
    spawn axis::ReservedRx(ext_recv, req_p, admit_c);
    spawn Service(req_c, egress_p, admit_p);
    spawn EgressDemux(egress_c, reply_p);
    spawn axis::Tx(reply_c, ext_send);
    (ext_recv, ext_send)
  }

  init { () }
  next(state: ()) { state }
}
