    let (tok, frame) = recv(join(), frame_in);
    let branch_0_tok = send(tok, branch_0_out, frame);
    let branch_1_tok = send(tok, branch_1_out, frame);
    let _done = join(branch_0_tok, branch_1_tok);
    state
  }
}

proc StartupPrefix0 {
