fn entry_effect(effects: EntryEffects, index: u8) -> Egress {
  match effects.layout {
    u8:0 => zero!<Egress>(),
    u8:1 => zero!<Egress>(),
    u8:2 => match index {
      u8:0 => Egress {
        port: OutputPort::NORTH,
        frame: axis::pack(Tag::PHENOM_DATA as u8,
          effects.payloads[0:96]),
