          (u32, token) in u32:0..HEIGHT {
        let address_x = (x * u32:1 + u32:0) as u16;
        let address_y = (y * u32:2 + u32:1) as u16;
        send_if(
          y_tok, frame_out[x][y],
          hls_spatial_router::contains(
            packet.rectangle, address_x, address_y),
          packet.frame)
