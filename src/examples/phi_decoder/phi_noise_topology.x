    egress_in: chan<phenom_data_cell::Egress> in,
    lane_0_out: chan<axis::Frame> out,
    lane_1_out: chan<axis::Frame> out,
    lane_2_out: chan<axis::Frame> out,
    lane_3_out: chan<axis::Frame> out,
