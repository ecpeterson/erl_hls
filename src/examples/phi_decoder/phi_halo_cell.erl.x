fn entry_effect_count(effects: EntryEffects) -> u8 {
  match effects.layout {
    u8:0 => u8:0,
    u8:1 => u8:2,
    u8:2 => u8:1,
    u8:3 => u8:4,
    u8:4 => u8:4,
    u8:5 => u8:5,
    u8:6 => u8:4,
    _ => u8:0,
  }
}

fn entry_effect(effects: EntryEffects, index: u8) -> Egress {
