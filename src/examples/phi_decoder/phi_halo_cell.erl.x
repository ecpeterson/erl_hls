fn initial_machine() -> Machine {
let _0 = Cell {
  ..zero!<Cell>()
};
let _1 = (Tag::CELL, _0);
let _2 = (Phase::CONFIGURING, _1, );
let _3 = if (bool:false) {
    zero!<Machine>()
} else {
    Machine {
  phase: _2.0,
  entered_from: _2.0,
  data: _2.1.1,
  enter_pending: u1:1,
  ..zero!<Machine>()
