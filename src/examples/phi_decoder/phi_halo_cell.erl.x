      u8:1 => Egress {
        port: OutputPort::SYNDROME,
        frame: axis::pack(Tag::PHENOM_REQUEST as u8,
          hls_bits::frame_payload(bits_from_phenomrequest(Phenomrequest {
            step: effects.payloads[96:128] as u32,
