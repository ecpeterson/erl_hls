+WireId Arch::resolveLutTimingSink(const NetInfo *net, const PortRef &sink, WireId nominal) const
+{
+    if (!xc7 || nominal == WireId() || sink.cell->type != id_SLICE_LUTX ||
+        !int_or_default(settings, id_route))
+        return nominal;
+
+    // fixupRouting() moves the packed port to the physical input, but retains the
+    // permutation PIP ending at the router's original input. Inspect at most six
+    // pins on this BEL. The site's other LUT half shares the same input wires.
+    auto bel = sink.cell->bel;
+    int z = getBelLocation(bel).z;
+    IdString pin = sink.cell->pins.count(sink.port) ? sink.cell->pins.at(sink.port) : sink.port;
+    if (pin.index < id_A1.index || pin.index > id_A6.index)
+        return nominal;
+    int physical = pin.index - id_A1.index;
+    int prefix = ((z >> 4) << 8) | (physical << 4);
+    auto direct = net->wires.find(nominal);
+    if (direct != net->wires.end()) {
+        PipId pip = direct->second.pip;
+        if (pip == PipId())
+            return nominal;
+        const auto &pd = locInfo(pip).pip_data[pip.index];
+        if (pd.flags != PIP_LUT_PERMUTATION || (pip.tile == bel.tile && pd.extra_data == (prefix | physical)))
+            return nominal;
+        // The same net may also feed a sibling input: ownership alone does not identify the tap.
+    }
+    WireId matched;
+    for (int i = 0; i < 6; ++i) {
+        WireId wire = getBelPinWire(bel, IdString(id_A1.index + i));
+        auto binding = net->wires.find(wire);
+        if (binding == net->wires.end())
+            continue;
+        PipId pip = binding->second.pip;
+        if (pip == PipId() || pip.tile != bel.tile)
+            continue;
+        const auto &pd = locInfo(pip).pip_data[pip.index];
+        if (pd.flags != PIP_LUT_PERMUTATION || pd.extra_data != (prefix | i))
+            continue;
+        if (matched != WireId())
+            return WireId();
+        matched = wire;
+    }
+    return matched;
 }

