{erl_opts, [debug_info]}.
{deps, []}.

{shell, [
    %% {config, "config/sys.config"},
    {apps, [erl_hls]}
]}.

{erl_first_files, [
    "src/api/hls_diagnostic.erl",
    "src/backend/xls/xls_parse.erl",
    "src/backend/xls/xls_names.erl",
    "src/backend/xls/xls_dslx_imports.erl",
    "src/api/hls_source.erl",
    "src/api/hls_actor_source.erl",
    "src/backend/xls/xls_clause_lower.erl",
    "src/backend/xls/xls_record_codegen.erl",
    "src/backend/xls/xls_failure_sites.erl",
    "src/backend/xls/xls_init.erl",
    "src/api/hls_type.erl",
    "src/api/hls_record.erl",
    "src/api/hls_records.erl",
    "src/backend/xls/xls_pattern_lower.erl",
    "src/backend/xls/xls_callback_lower.erl",
    "src/api/hls_continuation.erl",
    "src/api/hls_service_contract.erl",
    "src/backend/xls/xls_callback_result.erl",
    "src/backend/xls/xls_statem_callbacks.erl",
    "src/backend/xls/xls_statem_reduction_ir.erl",
    "src/backend/xls/xls_type_shape.erl",
    "src/backend/xls/xls_pattern_totality.erl",
    "src/backend/xls/xls_statem_reduction_lower.erl",
    "src/backend/xls/xls_statem_gather_lower.erl",
    "src/backend/xls/xls_known_bits.erl",
    "src/backend/xls/xls_entry_storage.erl",
    "src/backend/xls/xls_statem_entry.erl",
    "src/backend/xls/xls_statem_continuation.erl",
    "src/backend/xls/xls_statem_lower.erl",
    "src/api/hls_pack.erl"
]}.

% Package source compilation separately from optional external XLS invocation.
{relx, [{release, {erl_hls, "0.1.0"}, [erl_hls]},
        {dev_mode, false}, {include_erts, false}, {include_src, true},
        {overlay, [{copy, "bin/hlsc", "bin/hlsc"},
                   {copy, "priv/tools/compile_source_build.py", "bin/compile-source-build"}]}]}.
