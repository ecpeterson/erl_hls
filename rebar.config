{erl_opts, [debug_info]}.
{project_app_dirs, [
    "apps/erl_hls",
    "apps/hls_runtime",
    "apps/hls_fabric",
    "apps/router",
    "apps/hls_lowering",
    "apps/hls_phi",
    "apps/hls_snowflake"
]}.
{profiles, [
    {spacetime, [
        {project_app_dirs, ["apps/hls_spacetime", "apps/hls_spacetime_observer"]}
    ]}
]}.
{deps, []}.

%% Canonical production-source formatting; test fixture layout is intentional.
{project_plugins, [
    {erlfmt, {git, "https://github.com/WhatsApp/erlfmt",
        {ref, "2005d2581fede02e47791cf081dfa66be8d30acb"}}}
]}.
{erlfmt, [write, {print_width, 100},
    {files, ["apps/*/src/**/*.{erl,hrl}",
        "apps/erl_hls/include/**/*.hrl", "apps/hls_fabric/include/**/*.hrl"]}]}.

{shell, [
    %% {config, "config/sys.config"},
    {apps, [erl_hls]}
]}.

%% Standalone offline convenience command; no compiler or vendor tool dependency.
{escript_name, spacetime}.
{escript_main_app, hls_spacetime}.
{escript_emu_args, "%%! +S 2:2 -escript main hls_spacetime_cli\n"}.

%% The transport build API compiles trusted source files; include compiler APIs in type checking.
{dialyzer, [{plt_extra_apps, [compiler]}]}.

%% Compiler, build-tool, example and deployed-runtime closures remain distinct.
%% All use the host's compatible OTP 28 runtime.
{relx, [
    {release, {erl_hls, "0.1.0"}, [erl_hls], [
        {include_src, true},
        {overlay, [{copy, "bin/hlsc", "bin/hlsc"},
                   {copy, "apps/erl_hls/priv/tools/compile_source_build.py",
                       "bin/compile-source-build"},
                   {copy, "apps/erl_hls/priv/tools/compile_xls.py", "bin/compile_xls.py"}]}
    ]},
    {release, {hls, "0.1.0"}, [hls_lowering], [
        {include_src, true},
        {overlay, [{copy, "bin/hls-fabric", "bin/hls-fabric"},
                   {copy, "bin/compile-source-build", "bin/compile-source-build"}]}
    ]},
    {release, {hls_examples, "0.1.0"}, [hls_phi, hls_snowflake], [
        {include_src, true},
        {overlay, [{copy, "bin/hls-fabric", "bin/hls-fabric"},
                   {copy, "bin/hls-repetition", "bin/hls-repetition"},
                   {copy, "bin/compile-source-build", "bin/compile-source-build"}]}
    ]},
    {release, {hls_fabric, "0.1.0"}, [hls_fabric], [{include_src, false}]},
    {dev_mode, false},
    {include_erts, false}
]}.
