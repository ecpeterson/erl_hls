{erl_opts, [debug_info]}.
{deps, []}.

%% Canonical production-source formatting; test fixture layout is intentional.
{project_plugins, [
    {erlfmt, {git, "https://github.com/WhatsApp/erlfmt",
        {ref, "2005d2581fede02e47791cf081dfa66be8d30acb"}}}
]}.
{erlfmt, [write, {print_width, 100},
    {files, ["src/**/*.{erl,hrl}", "apps/*/src/**/*.{erl,hrl}", "include/**/*.hrl"]}]}.

{shell, [
    %% {config, "config/sys.config"},
    {apps, [erl_hls]}
]}.

{erl_first_files, [
    "src/backend/xls/types/xls_type.erl",
    "src/backend/xls/types/xls_nums.erl",
    "src/backend/xls/types/xls_provider_bits.erl",
    "src/backend/xls/types/xls_provider_bool.erl",
    "src/backend/xls/types/xls_provider_fixed.erl",
    "src/backend/xls/types/xls_provider_float.erl",
    "src/backend/xls/types/xls_provider_gs.erl",
    "src/backend/xls/types/xls_provider_lists.erl",
    "src/backend/xls/types/xls_provider_nums.erl",
    "src/backend/xls/types/xls_provider_prng.erl",
    "src/backend/xls/types/xls_provider_record.erl",
    "src/backend/xls/types/xls_provider_serial.erl",
    "src/backend/xls/types/xls_provider_type.erl",
    "src/backend/xls/types/xls_provider_vec.erl",
    "src/backend/xls/xls_parse.erl",
    "src/backend/xls/emission/xls_names.erl",
    "src/backend/xls/emission/xls_dslx_imports.erl",
    "src/frontend/hls_source.erl",
    "src/frontend/hls_actor_source.erl",
    "src/backend/xls/expressions/xls_clause_lower.erl",
    "src/backend/xls/types/xls_record_codegen.erl",
    "src/backend/xls/emission/xls_failure_sites.erl",
    "src/backend/xls/actors/xls_init.erl",
    "src/frontend/hls_records.erl",
    "src/backend/xls/expressions/xls_pattern_lower.erl",
    "src/backend/xls/expressions/xls_callback_lower.erl",
    "src/frontend/hls_service_contract.erl",
    "src/backend/xls/actors/xls_callback_result.erl",
    "src/backend/xls/actors/xls_statem_callbacks.erl",
    "src/backend/xls/actors/xls_statem_reduction_ir.erl",
    "src/backend/xls/analysis/xls_type_shape.erl",
    "src/backend/xls/analysis/xls_pattern_totality.erl",
    "src/backend/xls/actors/xls_statem_reduction_lower.erl",
    "src/backend/xls/actors/xls_statem_gather_lower.erl",
    "src/backend/xls/analysis/xls_known_bits.erl",
    "src/backend/xls/actors/xls_entry_storage.erl",
    "src/backend/xls/actors/xls_statem_entry.erl",
    "src/backend/xls/actors/xls_statem_continuation.erl",
    "src/backend/xls/analysis/xls_hardware_source.erl",
    "src/backend/xls/actors/xls_statem_lower.erl",
    "src/frontend/hls_pack.erl"
]}.

% Package source compilation separately from optional external XLS invocation.
{relx, [{release, {erl_hls, "0.1.0"}, [erl_hls]},
        {dev_mode, false}, {include_erts, false}, {include_src, true},
        {overlay, [{copy, "bin/hlsc", "bin/hlsc"},
                   {copy, "priv/tools/compile_source_build.py", "bin/compile-source-build"},
                   {copy, "priv/tools/compile_xls.py", "bin/compile_xls.py"}]}]}.
