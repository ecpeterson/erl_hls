// Exclude protocol-handled receipts; all other frames retain source validation.
fn local_plain_dispatch(machine: ActorState, frame: axis::Frame, received: bool)
    -> ActorDispatch {
  if hls_failure::failed(machine.failure) || machine.enter_pending || !received {
    ActorDispatch { machine, ..zero!<ActorDispatch>() }
  } else {
    let tag_ok = @@TAG_OK@@;
@@BINDINGS@@
    let invalid_repeat = tag_ok && repeat_phase && (directive != Directive::CONSUME || next_phase != machine.phase);
@@EFFECTIVE@@
    let phase_changed = effective && next_phase != machine.phase;
    let phase_boundary = phase_changed || (effective && repeat_phase);
@@FAILED@@
    let next_machine = ActorState {
      phase: if effective { next_phase } else { machine.phase },
      entered_from: if phase_boundary { machine.phase } else { machine.entered_from },
      data: if effective { next_data } else { machine.data },
@@NEXT_EVENT@@
      enter_pending: effective && phase_boundary && !failed,
      failure, ..machine
    };
    ActorDispatch {
      machine: next_machine,
@@DISPATCHED@@
      directive, phase_boundary, ..zero!<ActorDispatch>()
    }
  }
}

// Private action result: the updated machine and its original mailbox disposition
// stay together until entry/publication commits. This value is not actor state.
pub struct LocalAction {
  private_machine: MachineBits,
  dispatched: bool,
  directive: u2,
  phase_boundary: bool,
}

// The checked shared owner uses complete_locally=false after intercepting pending
// scalar work. Constant selection removes the local callback from that datapath.
fn local_action_selected_at(raw: MachineBits, frame: bits[128], received: bool,
    slot: u32, complete_locally: bool) -> LocalAction {
  let machine = local_machine(raw, slot);
  let dispatched = { @@SELECTED@@ };
  LocalAction {
    private_machine: bits_from_machine(dispatched.machine),
    dispatched: dispatched.dispatched,
    directive: dispatched.directive as u2,
    phase_boundary: dispatched.phase_boundary,
  }
}

// Select source callback work after receipt interception. Suppress received while
// local_pending_at is true. Retain the returned action and the selected mailbox
// head together; do not run another action while its entry is outstanding.
pub fn local_action_at(raw: MachineBits, frame: bits[128], received: bool,
    slot: u32) -> LocalAction {
  local_action_selected_at(raw, frame, received, slot, true)
}

// Evaluate entry from an owned action and the same slot. Reserve publication
// storage before accepting effects. If egress_blocked is true, retain the entire
// action for retry; ignore inactive payload fields and do not retire the head.
pub fn local_enter_at(action: LocalAction, effects_reserved: bool, slot: u32) -> LocalStepResult {
  let entered = shared_machine_enter(local_machine(action.private_machine, slot), effects_reserved);
  LocalStepResult {
    machine: bits_from_machine(entered.machine),
    effect_payload: entered.effects.payloads,
    effect_layout: entered.effects.layout,
    effect_count: entry_effect_count(entered.effects),
    effects_valid: entered.effects_valid,
    dispatched: action.dispatched,
    directive: action.directive,
    phase_boundary: action.phase_boundary,
    egress_blocked: entered.egress_blocked,
  }
}

// Compose the action and its entry immediately for the existing callback path.
// A final gather first supplies its private receipt state with received=false.
// The complete result equals local_step_at under the receipt/pending-work domain.
pub fn local_slow_step_at(raw: MachineBits, frame: bits[128], received: bool,
    effects_reserved: bool, slot: u32) -> LocalStepResult {
  local_enter_at(local_action_at(raw, frame, received, slot), effects_reserved, slot)
}
