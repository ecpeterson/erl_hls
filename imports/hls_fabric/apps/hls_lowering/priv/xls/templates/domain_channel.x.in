import axis;
import hls_bits;
import channel_controller as control;

@@INPUTS@@
@@OUTPUTS@@

// Canonical payload width follows the enclosing source build.
pub type Frame = bits[@@FRAME_BITS@@];

// Only the global cold reset may discard this state; endpoint resets cannot.
pub struct State { controller: control::ServiceState, frame: Frame, slot: u8 }

// Each tick returns old-state transfer observations and one committed successor.
pub struct Tick { state: State, output: Outputs }

// Payload movement follows decisions from the same Erlang kernel used natively.
pub fn tick(s: State, io: Inputs) -> Tick {
  let input = control::Channelinput {
    op: if io.fence { @@FENCE@@ } else if io.bind_request { @@BIND@@ } else { @@TICK@@ },
    expected_generation: io.expected_generation,
    source_incarnation: io.source_incarnation, destination_incarnation: io.destination_incarnation,
    source_ready: io.source_live, destination_live: io.destination_live,
    source_valid: io.source_valid, data_tx_ready: io.data_tx_ready,
    data_valid: io.data_valid, data_generation: io.data_generation, data_sequence: io.data_sequence,
    destination_ready: io.destination_ready, ack_tx_ready: io.ack_tx_ready,
    credit_valid: io.credit_valid, credit_generation: io.credit_generation, credit_sequence: io.credit_sequence,
  };
  let result = control::service_step(s.controller,
    axis::pack(control::Tag::CHANNEL_INPUT as u8,
      hls_bits::frame_payload(control::bits_from_channelinput(input))));
  let observed = control::channeloutput_from_bits(result.response.payload);
  let live = !io.reset && result.state.failure == u32:0;
  let take = live && observed.source_take;
  Tick {
    state: if io.reset { State { controller: control::initial_service_state(), frame: Frame:0, slot:u8:0 } }
      else { State { controller:result.state, frame:if take {io.source_frame} else {s.frame}, slot:if take {io.source_slot} else {s.slot} } },
    output: Outputs {
      source_ready:take, tx_valid:live && observed.tx_valid,
      tx_generation:observed.generation, tx_sequence:observed.sequence, tx_slot:s.slot, tx_frame:s.frame,
      data_ready:live && observed.data_ready, data_drop:live && observed.data_drop,
      destination_valid:live && observed.destination_valid, destination_slot:io.data_slot, destination_frame:io.data_frame,
      ack_valid:live && observed.ack_valid, ack_generation:observed.generation, ack_sequence:observed.sequence,
      credit_ready:live && observed.credit_ready, credit_drop:live && observed.credit_drop,
      generation:observed.generation,
      bound_source_incarnation:observed.state.source_incarnation,
      bound_destination_incarnation:observed.state.destination_incarnation,
      packet_sequence:observed.sequence, status:observed.status,
      active:live && observed.state.active, fault:!io.reset && result.state.failure != u32:0,
    },
  }
}

// The external pin adapter samples all channels on the same hardware edge.
pub proc channel_clock {
  commands:chan<Inputs> in;
  observations:chan<Outputs> out;
  // Both sampled channels are permanently enabled by the mechanical adapter.
  config(commands:chan<Inputs> in, observations:chan<Outputs> out) { (commands,observations) }
  // A cold channel has no binding or admitted packet.
  init { zero!<State>() }
  // Endpoint retirement changes kernel ownership without resetting these registers.
  next(s:State) {
    let (tok,io)=recv(join(),commands);
    let result=tick(s,io);
    let _sent=send(tok,observations,result.output);
    result.state
  }
}
