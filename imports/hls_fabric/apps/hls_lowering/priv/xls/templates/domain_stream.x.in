import axis;
import std;
import arbitration;
import domain;
import domain_codes;
import domain_frames as framing;

// Lifecycle wire widths come from the compiled Erlang enum descriptors.
type Operation = bits[@@OPERATION_BITS@@];
type Status = bits[@@STATUS_BITS@@];
type Action = bits[@@ACTION_BITS@@];
type Fault = bits[@@FAULT_BITS@@];

const PACKET_BITS = u32:@@PACKET_BITS@@;
const SLOT_COUNT = u32:@@SLOTS@@;
const OUTPUT_COUNT = u32:@@OUTPUTS@@;
const SOURCE_COUNT = OUTPUT_COUNT + u32:1;
// A granted source is already range-checked by the contender vector.
type Cursor = uN[std::clog2(SOURCE_COUNT) as u32 + (SOURCE_COUNT == u32:1) as u32];
type Packet = framing::Packet<PACKET_BITS>;
type Receive = framing::Receive<PACKET_BITS>;
// One live source call owns an outer request identity until its reply is accepted.
struct Call { valid: bool, request: u32 }
// Source-checked command address; out-of-range values never reach the actor network.
struct Command { valid: bool, call: bool, slot: u32, target: u2, x: u16, y: u16 }
// One selected external source stream. Reply slots are local to that source actor.
struct Output { valid: bool, actor: u32, port: u32, reply: bool, base: u32, count: u32, frame: axis::Frame }
// External pin ABI; application backpressure never owns management's parser or output.
pub struct Inputs {
  reset: bool,
  management_word: u32, management_valid: bool, management_last: bool, management_output_ready: bool,
  application_word: u32, application_valid: bool, application_last: bool, application_output_ready: bool,
}
// All transfer indications describe the current edge, before committing State.
pub struct Outputs {
  management_ready: bool, management_output_word: u32, management_output_valid: bool, management_output_last: bool,
  application_ready: bool, application_output_word: u32, application_output_valid: bool, application_output_last: bool,
  wire_fault: bool,
}
// Transport state survives ordinary domain replacement; only cold device reset clears it.
pub struct State {
  core: domain::State,
  management_rx: Receive, application_rx: Receive,
  management_tx: Packet, management_tx_valid: bool, management_position: u32,
  application_tx: Packet, application_tx_valid: bool, application_position: u32,
  management_pending: bool, management_request: u32, management_header: u32, management_route: u32,
  management_status: Status, management_action: Action,
  calls: Call[SLOT_COUNT], incarnation: u64, last_request: u32,
  sequence: u32, cursor: u32, fault: bool,
}
// One clock's immutable observation and its complete successor state.
pub struct Tick { state: State, output: Outputs }
// Source-generated selectors preserve the existing rectangle ingress and ordinary record framing.
fn command(actor: u32, tag: u8, kind: u32, slot: u32, words: u8) -> Command {
  @@COMMANDS@@
}
// Select the granted source payload after arbitration over narrow availability bits.
fn output(index: u32, observation: domain::Outputs) -> Output {
  @@OUTPUT_SELECT@@
}
// Include ingress only when its complete head can be admitted or rejected now.
// Every continuously eligible source wins within one round of accepted packets;
// an unavailable source never spends a turn. No payload is selected in this scan.
pub fn arbitrate(observation: domain::Outputs, ingress: bool, cursor: u32) -> (bool, u32) {
  let requests = unroll_for! (i, requests):
      (u32, bool[SOURCE_COUNT]) in u32:0..OUTPUT_COUNT {
    update(requests, i, output(i, observation).valid)
  }(update(zero!<bool[SOURCE_COUNT]>(), OUTPUT_COUNT, ingress));
  arbitration::select(requests, cursor)
}
// One little-endian word from a canonical packet payload.
fn word(packet: Packet, index: u32) -> u32 { (packet.payload >> (index*u32:32)) as u32 }
// Counter fields use two complete words; they are never narrowed on transport.
fn pair(packet: Packet, index: u32) -> u64 { word(packet,index+u32:1) ++ word(packet,index) }
// Acknowledgements, replies and effects share one ordered nonwrapping output sequence.
fn response(sequence: u32, incarnation: u64, actor: u32, request: u32, disposition: u32,
            port: u32, frame: axis::Frame, operation: u8, original: u32) -> Packet {
  let payload = (sequence as bits[PACKET_BITS]) |
    (incarnation as bits[PACKET_BITS] << u32:32) |
    (actor as bits[PACKET_BITS] << u32:96) |
    (request as bits[PACKET_BITS] << u32:128) |
    (disposition as bits[PACKET_BITS] << u32:160) |
    (port as bits[PACKET_BITS] << u32:192) |
    (axis::bits_from_header(frame.header) as bits[PACKET_BITS] << u32:224) |
    (frame.payload as bits[PACKET_BITS] << u32:256);
  Packet { route: u32:1, header: framing::header(original, operation, u8:8+frame.header.payload_words), payload }
}
// Management captures a committed lifecycle snapshot and every previously accepted application output.
fn snapshot(s: State, observed: domain::Outputs) -> Packet {
  let payload = (s.management_request as bits[PACKET_BITS]) |
    (s.management_status as bits[PACKET_BITS] << u32:32) |
    (s.management_action as bits[PACKET_BITS] << u32:64) |
    (observed.domain_phase as bits[PACKET_BITS] << u32:96) |
    (observed.domain_current as bits[PACKET_BITS] << u32:128) |
    (observed.domain_previous as bits[PACKET_BITS] << u32:192) |
    (observed.domain_target as bits[PACKET_BITS] << u32:256) |
    (observed.domain_transition as bits[PACKET_BITS] << u32:320) |
    (observed.domain_fault as bits[PACKET_BITS] << u32:384) |
    (observed.domain_source_fault as bits[PACKET_BITS] << u32:416) |
    (observed.domain_source_actor as bits[PACKET_BITS] << u32:448) |
    (s.sequence as bits[PACKET_BITS] << u32:480);
  Packet { route: s.management_route, header: framing::header(s.management_header,u8:1,u8:16), payload }
}
// Advance only a completed stream transfer. A blocked beat is stable until accepted.
pub fn tick(s: State, io: Inputs) -> Tick {
  let mgmt_done = s.management_tx_valid && io.management_output_ready && framing::last(s.management_tx,s.management_position);
  let app_done = s.application_tx_valid && io.application_output_ready && framing::last(s.application_tx,s.application_position);
  let mgmt_space = !s.management_tx_valid || mgmt_done;
  let app_space = !s.application_tx_valid || app_done;
  let management_ready = !s.management_rx.full && !io.reset;
  let application_ready = !s.application_rx.full && !io.reset && !s.fault;
  let mgmt_rx = if management_ready && io.management_valid { framing::receive(s.management_rx,io.management_word,io.management_last) } else { s.management_rx };
  let app_rx = if application_ready && io.application_valid { framing::receive(s.application_rx,io.application_word,io.application_last) } else { s.application_rx };
  let management = s.management_rx.packet;
  let management_inspect = management.header[24+:u8] == u8:0 && management.header[0+:u8] == u8:1;
  let management_request = management.header[24+:u8] == u8:1 && management.header[0+:u8] == u8:9;
  let management_envelope_valid = management.route == u32:0 && (management.header & u32:0x00ffff00) == u32:0;
  let management_codes_valid = (word(management,u32:1) >> bit_count<Operation>()) == u32:0 &&
    (word(management,u32:8) >> bit_count<Fault>()) == u32:0;
  let management_valid = s.management_rx.full && !s.management_rx.bad && management_envelope_valid &&
    (management_inspect || (management_request && management_codes_valid)) && !s.management_pending && mgmt_space;
  let app = s.application_rx.packet;
  let incarnation = pair(app,u32:0);
  let actor = word(app,u32:2);
  let request = word(app,u32:3);
  let kind = word(app,u32:4);
  let slot = word(app,u32:5);
  let frame = axis::Frame { header: axis::header_from_bits(word(app,u32:6)), payload: (app.payload >> u32:224) as bits[axis::PAYLOAD_BITS] };
  let selection = command(actor,frame.header.op,kind,slot,frame.header.payload_words);
  let current = s.core.control.data.lifecycle.current;
  let live_calls = if current == s.incarnation { s.calls } else { zero!<Call[SLOT_COUNT]>() };
  let last_request = if current == s.incarnation { s.last_request } else { u32:0 };
  let stale = incarnation == u64:0 || incarnation != current || s.core.control.data.lifecycle.phase != domain_codes::PHASE_READY || request <= last_request || request == u32:0;
  let malformed = s.application_rx.bad || app.route != u32:1 || app.header[24+:u8] != u8:2 || (app.header & u32:0x00ffff00) != u32:0 ||
    app.header[0+:u8] as u32 != u32:7 + frame.header.payload_words as u32 ||
    !selection.valid || frame.header.txid as u32 != (if kind == u32:1 {slot} else {u32:0}) || frame.header.flags != u8:0;
  let occupied = selection.call && live_calls[selection.slot].valid;
  let exhausted = s.sequence == u32:0xffffffff;
  let reject = stale || malformed || occupied || exhausted;
  let spatial = selection.x ++ selection.y ++ selection.x ++ selection.y ++ selection.target ++
    frame.header.payload_words ++ frame.header.txid ++ frame.header.flags ++ frame.header.op ++ frame.payload;
  let control = domain::Inputs {
    reset: io.reset, transport_fault: s.fault || exhausted,
    management_valid: management_valid && management_request,
    management_op: word(management,u32:1) as Operation,
    expected: pair(management,u32:2), target: pair(management,u32:4), transition: pair(management,u32:6),
    management_fault: word(management,u32:8) as Fault,
    incarnation, ingress_data: spatial, ..zero!<domain::Inputs>()
  };
  // Availability is a pre-edge observation, independent of application handshakes.
  // Only these narrow output fields survive this preview; its successor is unused.
  let observation = domain::tick(s.core, control).output;
  let ingress = s.application_rx.full && (reject || observation.app_ingress_ready);
  let (available, grant) = arbitrate(observation, ingress, s.cursor);
  let granted = available && app_space && !io.reset && !s.fault && !exhausted;
  let input_turn = grant == OUTPUT_COUNT;
  let offer = granted && input_turn;
  // Commit the actor/link network once, with exactly one selected external transfer.
  let core = domain::tick(s.core,domain::Inputs {
    ingress_valid: offer && !reject,
    @@OUTPUT_READY@@
    ..control
  });
  let selected = output(grant,core.output);
  let output_take = granted && !input_turn && selected.valid;
  let reply_index = selected.base + selected.frame.header.txid as u32;
  let valid_reply = !selected.reply || (selected.frame.header.txid as u32 < selected.count && live_calls[reply_index].valid);
  let output_good = output_take && valid_reply;
  let input_take = offer && (reject || core.output.app_ingress_ready);
  let new_sequence = s.sequence + (input_take || output_good) as u32;
  let disposition = if stale { u32:1 } else if malformed { u32:2 } else if occupied { u32:3 } else if exhausted { u32:4 } else { u32:0 };
  let accepted_calls = if input_take && !reject && selection.call {
    update(live_calls,selection.slot,Call {valid:true,request})
  } else { live_calls };
  let calls = if output_good && selected.reply { update(accepted_calls,reply_index,zero!<Call>()) } else { accepted_calls };
  let application_tx = if input_take {
    response(new_sequence,incarnation,actor,request,disposition,u32:0,zero!<axis::Frame>(),u8:2,app.header)
  } else if output_good {
    response(new_sequence,current,selected.actor,if selected.reply {live_calls[reply_index].request} else {u32:0},u32:0,
      selected.port,selected.frame,if selected.reply {u8:3} else {u8:4},u32:0)
  } else { s.application_tx };
  let management_take = management_valid && (management_inspect || core.output.management_response_valid);
  let management_capture = s.management_pending && mgmt_space;
  let next = State {
    core:core.state, incarnation:current, calls,
    last_request:if input_take && !stale {request} else {last_request}, sequence:new_sequence,
    cursor:if input_take || output_good {arbitration::successor<SOURCE_COUNT>(grant as Cursor) as u32} else {s.cursor},
    fault:s.fault || (output_take && !valid_reply) || exhausted ||
      (s.management_rx.full && (s.management_rx.bad || !(management_inspect || management_request) || !management_envelope_valid || (management_request && !management_codes_valid))),
    management_rx:if management_take {zero!<Receive>()} else {mgmt_rx},
    application_rx:if input_take {zero!<Receive>()} else {app_rx},
    management_tx:if management_capture {snapshot(State{sequence:new_sequence,..s},core.output)} else {s.management_tx},
    management_tx_valid:management_capture || (s.management_tx_valid && !mgmt_done),
    management_position:if mgmt_done || management_capture {u32:0} else {s.management_position+(s.management_tx_valid && io.management_output_ready) as u32},
    application_tx, application_tx_valid:input_take || output_good || (s.application_tx_valid && !app_done),
    application_position:if app_done || input_take || output_good {u32:0} else {s.application_position+(s.application_tx_valid && io.application_output_ready) as u32},
    management_pending:management_take || (s.management_pending && !management_capture),
    management_request:if management_take {word(management,u32:0)} else {s.management_request},
    management_header:if management_take {management.header} else {s.management_header},
    management_route:if management_take {management.route} else {s.management_route},
    management_status:if management_take {if management_inspect {domain_codes::STATUS_OK} else {core.output.domain_status}} else {s.management_status},
    management_action:if management_take {if management_inspect {domain_codes::ACTION_NONE} else {core.output.domain_action}} else {s.management_action},
  };
  Tick { state:if io.reset {zero!<State>()} else {next}, output:Outputs {
    management_ready, application_ready,
    management_output_valid:s.management_tx_valid && !io.reset,
    management_output_word:framing::word(s.management_tx,s.management_position),
    management_output_last:framing::last(s.management_tx,s.management_position),
    application_output_valid:s.application_tx_valid && !io.reset,
    application_output_word:framing::word(s.application_tx,s.application_position),
    application_output_last:framing::last(s.application_tx,s.application_position),wire_fault:s.fault,
  }}
}
// The physical adapter transfers one sampled command/observation on every clock.
pub proc domain_stream_clock {
  commands:chan<Inputs> in; observations:chan<Outputs> out;
  // Bind both sampled buses; payload backpressure is represented inside Inputs.
  config(commands:chan<Inputs> in,observations:chan<Outputs> out){(commands,observations)}
  // Cold state has no incarnation, ownership or transport history.
  init {zero!<State>()}
  // All control decisions and framing are synthesized; the simulator supplies only beats.
  next(state:State){let(tok,input)=recv(join(),commands);let result=tick(state,input);let _=send(tok,observations,result.output);result.state}
}
