import axis;
import hls_bits;
import endpoint_rx_controller as control;

// One source-derived alias serves every binding field with the exact native codec.
type Binding = control::@@BINDING_TYPE@@;

@@INPUTS@@
@@OUTPUTS@@

// The application frame keeps its own width regardless of controller message capacity.
pub type Frame = bits[@@FRAME_BITS@@];

// One payload/slot and all metadata survive local domain reset; cold reset alone clears them.
pub struct State { controller: control::ClockState, frame: Frame, slot: u8 }

// Old-state handshakes and one committed successor describe the sampled local edge.
pub struct Tick { state: State, output: Outputs }

// Binding and capture require explicit later inputs after a cold start.
pub fn initial_state() -> State {
  State { controller: control::clock_initial(), frame: Frame:0, slot: u8:0 }
}

// Network capture, native capture and ACK handoff remain separate native-kernel edges.
// Cold state reset belongs to the enclosing proc; this helper gates reset-edge outputs.
fn tick(s: State, io: Inputs) -> Tick {
  let input = control::@@INPUT_TYPE@@ {
    op: if io.fence { @@FENCE@@ } else if io.bind_request { @@BIND@@ } else { @@TICK@@ },
    binding: Binding {
      namespace: io.namespace, generation: io.generation,
      source_incarnation: io.source_incarnation, destination_incarnation: io.destination_incarnation,
    },
    local_ready: io.local_ready, local_incarnation: io.local_incarnation,
    data_valid: io.data_valid,
    data_packet: control::@@PACKET_TYPE@@ {
      binding: Binding {
        namespace: io.data_namespace, generation: io.data_generation,
        source_incarnation: io.data_source_incarnation,
        destination_incarnation: io.data_destination_incarnation,
      },
      sequence: io.data_sequence,
    },
    destination_ready: io.destination_ready, ack_tx_ready: io.ack_tx_ready,
  };
  let result = control::clock_step(s.controller,
    axis::pack(control::Tag::@@INPUT_TAG@@ as u8,
      hls_bits::frame_payload(control::bits_from_@@INPUT_CODEC@@(input))));
  let observed = control::@@OUTPUT_CODEC@@_from_bits(result.response.payload);
  let retained = result.state.data.channel;
  let live = !io.reset && result.state.failure == u32:0;
  let take = live && observed.data_take;
  Tick {
    // The proc's physical reset pin restores init state. Repeating that reset
    // here creates a second next-value choice and masks every payload data bit.
    // The mechanical wrapper connects the same reset to this input and the proc.
    state: State { controller: result.state,
        frame: if take { io.data_frame } else { s.frame },
        slot: if take { io.data_slot } else { s.slot } },
    output: Outputs {
      data_ready: live && observed.data_ready, data_take: take, data_drop: live && observed.data_drop,
      destination_valid: live && observed.destination_valid,
      destination_take: live && observed.destination_take,
      destination_slot: s.slot, destination_frame: s.frame,
      ack_valid: live && observed.ack_valid,
      ack_namespace: observed.packet.binding.namespace,
      ack_generation: observed.packet.binding.generation,
      ack_source_incarnation: observed.packet.binding.source_incarnation,
      ack_destination_incarnation: observed.packet.binding.destination_incarnation,
      ack_sequence: observed.packet.sequence,
      bound_namespace: retained.binding.namespace, bound_generation: retained.binding.generation,
      bound_source_incarnation: retained.binding.source_incarnation,
      bound_destination_incarnation: retained.binding.destination_incarnation,
      packet_sequence: retained.sequence, status: observed.status,
      active: live && retained.active, fault: !io.reset && result.state.failure != u32:0,
      failure: if io.reset { u32:0 } else { result.state.failure },
    },
  }
}

// This destination endpoint samples only its own local clock and lifecycle.
pub proc endpoint_rx_clock {
  commands: chan<Inputs> in;
  observations: chan<Outputs> out;
  // The pin adapter permanently enables both channels; native stalls are sampled fields.
  config(commands: chan<Inputs> in, observations: chan<Outputs> out) { (commands, observations) }
  // Cold initialization cannot deliver or acknowledge a previous publication.
  init { initial_state() }
  // Destination payload always comes from retained storage, never the current carrier offer.
  next(s: State) {
    let (tok, io) = recv(join(), commands);
    let result = tick(s, io);
    let _sent = send(tok, observations, result.output);
    result.state
  }
}
