// Test-only batch ABI: four distinct effects, with optional two-effect prefix.
// The router and routing send bodies are generated by production Erlang modules.
import axis;

// Three source ports, with REPORT multicast to the two independent output lanes.
pub enum OutputPort : u8 { NORTH = 0, SOUTH = 1, REPORT = 2 }
// One ordered output combines its route and all 128 frame bits.
pub struct Egress { port: OutputPort, frame: axis::Frame }
// The four-element list is finite; count zero denotes a terminal empty batch.
pub struct ScheduledEffects { slot: u32, count: u8, prefix: bool, effects: Egress[4] }
// Completion credit uses the production credit/slot/frame tuple order.
pub struct ScheduledRequest { credit: bool, slot: u32, frame: axis::Frame }

// All defined indices produce a value; count zero is an empty terminal batch.
pub fn scheduled_effect(scheduled: ScheduledEffects, index: u8) -> (Egress, bool, bool) {
  let entry = scheduled.effects[(index as u32) & u32:3];
  let present = index < scheduled.count;
  (entry, present, !present || index + u8:1 >= scheduled.count)
}

// Prefix batches always start with NORTH/SOUTH and may continue with REPORT.
pub fn scheduled_reduction_prefix(scheduled: ScheduledEffects) -> (bool, u32, bool) {
  (scheduled.prefix && scheduled.count >= u8:2, u32:0, scheduled.count == u8:2)
}
