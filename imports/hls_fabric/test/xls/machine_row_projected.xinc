// The selected slot restores constants while the seven mutable bits keep their historical offsets.
#[test]
fn physical_projected_row_abi() {
  for (slot, _): (u32, ()) in u32:0..u32:2 {
    for (value, _): (u32, ()) in u32:0..u32:128 {
      let data = if slot == u32:0 {
        Cell {id: uN[13]:4567, bias: sN[11]:-731, value: value as u7}
      } else { Cell {id: uN[13]:1234, bias: sN[11]:513, value: value as u7} };
      let machine = ActorState {phase: Phase::READY, entered_from: Phase::BOOT,
        data, enter_pending: true, failure: u16:0xa55a};
      let expected = u16:0xa55a ++ u1:1 ++ (value as u7) ++
        (Phase::BOOT as u8) ++ (Phase::READY as u8);
      assert_eq(bits_from_machine(machine), expected);
      assert_eq(machine_from_bits<u32:0>(expected, slot), machine);
      ()
    }(())
  }(())
}
