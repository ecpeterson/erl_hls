{erl_opts, [debug_info, warnings_as_errors]}.
%% Offline observation is an ordinary OTP application, selected only by its profile.
{project_app_dirs, [".", "apps/hls_lowering", "apps/hls_phi", "apps/hls_snowflake"]}.
{profiles, [
    {spacetime, [
        {project_app_dirs, ["apps/hls_spacetime_observer"]},
        %% Profile dependencies are not locked by rebar3; retain an exact source revision.
        {deps, [
            {hls_spacetime, {git, "https://github.com/ecpeterson/hls_spacetime.git",
                {ref, "c2b0c328d095fa8410231a9120c1298393ae2e31"}}}
        ]}
    ]}
]}.
%% Both compiler-owned applications use the same reviewed source revision.
{deps, [
    {erl_hls, {git, "https://github.com/ecpeterson/erl_hls.git", {ref, "ee2d0280ab8662e338d242eac625075969a83e58"}}},
    {hls_runtime, {git_subdir, "https://github.com/ecpeterson/erl_hls.git", {ref, "ee2d0280ab8662e338d242eac625075969a83e58"}, "apps/hls_runtime"}}
]}.
{shell, [{apps, [hls_fabric]}]}.

% The transport build API compiles trusted source files; include compiler APIs in type checking.
{dialyzer, [{plt_extra_apps, [compiler]}]}.

% Build tooling and deployed runtime are separate release closures.
% Both use the host's compatible OTP 28 runtime.
{relx, [
    {release, {hls, "0.1.0"}, [hls_lowering], [
        {include_src, true},
        {overlay, [{copy, "bin/hls-fabric", "bin/hls-fabric"},
                   {copy, "bin/compile-source-build", "bin/compile-source-build"}]}
    ]},
    {release, {hls_examples, "0.1.0"}, [hls_phi, hls_snowflake], [
        {include_src, true},
        {overlay, [{copy, "bin/hls-fabric", "bin/hls-fabric"},
                   {copy, "bin/hls-repetition", "bin/hls-repetition"},
                   {copy, "bin/compile-source-build", "bin/compile-source-build"}]}
    ]},
    {release, {hls_fabric, "0.1.0"}, [hls_fabric], [{include_src, false}]},
    {dev_mode, false}, {include_erts, false}
]}.

%% Canonical production-source formatting; test fixture layout is intentional.
{project_plugins, [
    {erlfmt, {git, "https://github.com/WhatsApp/erlfmt",
        {ref, "2005d2581fede02e47791cf081dfa66be8d30acb"}}}
]}.
{erlfmt, [write, {print_width, 100},
    {files, ["src/**/*.{erl,hrl}", "apps/*/src/**/*.{erl,hrl}", "include/**/*.hrl"]}]}.
