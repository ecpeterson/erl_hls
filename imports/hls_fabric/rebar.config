{erl_opts, [debug_info, warnings_as_errors]}.
{deps, [{erl_hls, {git, "https://github.com/ecpeterson/erl_hls.git", {ref, "bb6d70c488f25b2135c84691c1e982e2a4eee355"}}}]}.
{shell, [{apps, [hls_fabric]}]}.

% The transport build API compiles trusted source files; include compiler APIs in type checking.
{dialyzer, [{plt_extra_apps, [compiler]}]}.

% The CLI release contains BEAMs, templates, headers and example sources.
% No ERTS is bundled: use the same OTP 28 runtime as ordinary compilation.
{relx, [{release, {hls, "0.1.0"}, [hls_fabric]},
        {dev_mode, false}, {include_erts, false}, {include_src, true},
        {overlay, [{copy, "bin/hls-fabric", "bin/hls-fabric"},
                   {copy, "bin/hls-repetition", "bin/hls-repetition"},
                   {copy, "bin/compile-source-build", "bin/compile-source-build"}]}]}.
