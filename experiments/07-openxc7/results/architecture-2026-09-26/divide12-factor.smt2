(set-logic ALL)
(declare-const n Int)
(define-fun original () Int (ite (< n 0) (- (div (+ (- n) 6) 12)) (div (+ n 6) 12)))
(define-fun shifted () Int (div (+ n (ite (< n 0) 1 2)) 4))
(define-fun proposed () Int (ite (< shifted 0) (- (div (+ (- shifted) 1) 3)) (div (+ shifted 1) 3)))
(push)
(assert (not (= original proposed)))
(check-sat)
(pop)

; Four signed-32 neighbors and the 1:7 weighted local pair fit signed 36.
(declare-const a Int)
(declare-const b Int)
(declare-const neighbors Int)
(assert (and (<= (- 2147483648) a) (<= a 2147483647)))
(assert (and (<= (- 2147483648) b) (<= b 2147483647)))
(assert (and (<= (- 8589934592) neighbors) (<= neighbors 8589934588)))
(define-fun numerator () Int (+ a (* 7 b) neighbors))
(define-fun reduced () Int (div (+ numerator (ite (< numerator 0) 1 2)) 4))
(assert (not (and (<= (- 34359738368) numerator) (< numerator 34359738368)
                 (<= (- 17179869184) reduced) (< reduced 17179869184))))
(check-sat)
