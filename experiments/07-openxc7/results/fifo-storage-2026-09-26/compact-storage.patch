+// A one-entry FIFO needs one occupancy bit and one payload register. Keep the
+// same bypass and registered-push handshakes as the general ring buffer.
+absl::StatusOr<Block*> MaterializeDepthOneFifo(
+    BlockBuilder& bb, FifoInstantiation* inst, BValue reset_port,
+    BValue push_valid, BValue pop_ready) {
+  const FifoConfig& config = inst->fifo_config();
+  XLS_RET_CHECK_EQ(config.depth(), 1);
+  XLS_RET_CHECK(!config.register_pop_outputs());
+  XLS_ASSIGN_OR_RETURN(
+      Register * slots_reg,
+      bb.block()->AddRegisterWithZeroResetValue("slots", push_valid.GetType()));
+  BValue slots = bb.RegisterRead(slots_reg);
+  BValue full = bb.Eq(slots, bb.Literal(UBits(1, 1)), SourceInfo(),
+                     "is_full_bool");
+  BValue push_ready = config.register_push_outputs()
+                         ? bb.Not(full)
+                         : bb.Or(bb.Not(full), pop_ready);
+  BValue pop_valid = config.bypass() ? bb.Or(slots, push_valid) : slots;
+  bb.OutputPort(FifoInstantiation::kPushReadyPortName, push_ready);
+  bb.OutputPort(FifoInstantiation::kPopValidPortName, pop_valid);
+
+  BValue pushed = bb.And(push_ready, push_valid);
+  BValue popped = bb.And(pop_ready, pop_valid);
+  // Equal accepted push/pop counts preserve occupancy, including empty bypass
+  // and full replacement; otherwise the accepted push determines occupancy.
+  BValue next_slots = bb.Select(bb.Xor(pushed, popped), {slots, pushed});
+  bb.RegisterWrite(slots_reg, next_slots, /*load_enable=*/std::nullopt,
+                   reset_port);
+  if (inst->data_type()->GetFlatBitCount() > 0) {
+    BValue push_data =
+        bb.InputPort(FifoInstantiation::kPushDataPortName, inst->data_type());
+    XLS_ASSIGN_OR_RETURN(
+        Register * buf_reg,
+        bb.block()->AddRegisterWithZeroResetValue("buf", inst->data_type()));
+    BValue stored = bb.RegisterRead(buf_reg);
+    BValue pop_data = config.bypass()
+                          ? bb.Select(slots, {push_data, stored})
+                          : stored;
+    bb.OutputPort(FifoInstantiation::kPopDataPortName, pop_data);
+    // Empty bypasses leave payload storage untouched.
+    BValue store = config.bypass()
+                       ? bb.And(pushed, bb.Or(slots, bb.Not(pop_ready)))
+                       : pushed;
+    bb.RegisterWrite(buf_reg, push_data, /*load_enable=*/store, reset_port);
+  }
+  return bb.Build();
+}
