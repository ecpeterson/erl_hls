 #include "command.h"
 #include "design_utils.h"
 #include "jsonwrite.h"
+#include "json11.hpp"
 #include "log.h"
 #include "timing.h"
 
 USING_NEXTPNR_NAMESPACE
+
+// Report the backend's actual port classification. This is a coverage probe,
+// not a claim that every combinational arc or clock relationship is modeled.
+static void writeTimingCoverage(Context *ctx, const std::string &filename)
+{
+    using json11::Json;
+    static const char *classes[] = {"clock_input", "generated_clock", "register_input", "register_output",
+                                   "comb_input", "comb_output", "startpoint", "endpoint", "ignore"};
+    Json::object cells;
+    for (const auto &entry : ctx->cells) {
+        const CellInfo *cell = entry.second.get();
+        Json::object ports;
+        for (const auto &entry : cell->ports) {
+            const auto &port = entry.second;
+            if (port.net == nullptr)
+                continue;
+            int count = 0;
+            TimingPortClass kind = ctx->getPortTimingClass(cell, port.name, count);
+            Json::array clocks;
+            for (int i = 0; i < count; ++i) {
+                auto info = ctx->getPortClockingInfo(cell, port.name, i);
+                clocks.push_back(Json::object{{"port", info.clock_port.str(ctx)},
+                                             {"edge", info.edge == RISING_EDGE ? "rising" : "falling"},
+                                             {"setup_ns", ctx->getDelayNS(info.setup.maxDelay())},
+                                             {"hold_ns", ctx->getDelayNS(info.hold.maxDelay())},
+                                             {"clock_to_q_ns", ctx->getDelayNS(info.clockToQ.maxDelay())}});
+            }
+            ports[port.name.str(ctx)] = Json::object{{"class", classes[int(kind)]},
+                {"direction", port.type == PORT_IN ? "input" : port.type == PORT_OUT ? "output" : "inout"},
+                {"net", port.net->name.str(ctx)}, {"clocks", clocks}};
+        }
+        cells[cell->name.str(ctx)] = Json::object{{"type", cell->type.str(ctx)},
+                                                 {"placed", cell->bel != BelId()}, {"ports", ports}};
+    }
+    std::ofstream out(filename);
+    if (!out)
+        log_error("Cannot open timing coverage file '%s'\n", filename.c_str());
+    out << Json(Json::object{{"schema", 1}, {"cells", cells}}).dump() << '\n';
+    out.close();
+    if (!out)
+        log_error("Cannot write timing coverage file '%s'\n", filename.c_str());
+}
 
