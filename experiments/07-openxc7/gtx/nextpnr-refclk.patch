+    // GTX CLKSWING is shared by both reference buffers, independently of QPLL use.
+    // Emit the buffers' requested value and reject contradictory shared settings.
+    void write_gtx_refclk_swing(CellInfo *ci)
+    {
+        int swing = 3;
+        bool found = false;
+        for (auto &entry : ctx->cells) {
+            auto other = entry.second.get();
+            if (other->type != id_IBUFDS_GTE2 || other->bel.tile != ci->bel.tile)
+                continue;
+            int requested = int_or_default(other->params, ctx->id("CLKSWING_CFG"), 3);
+            if (requested < 0 || requested > 3 || (found && swing != requested))
+                log_error("Incompatible GTX reference-buffer CLKSWING_CFG in %s\n",
+                          get_tile_name(ci->bel.tile).c_str());
+            swing = requested;
+            found = true;
+        }
+        if (swing != 3)
+            log_warning("According to UG476, GTX CLKSWING_CFG should always be 0b11\n");
+        push(get_tile_name(ci->bel.tile));
+        push("GTXE2_COMMON");
+        write_int_vector("IBUFDS_GTE2.CLKSWING_CFG[1:0]", swing, 2);
+        pop(2);
+    }
+
