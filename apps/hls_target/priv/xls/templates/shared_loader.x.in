// Load one reserved activation. The scheduler owns actor/mailbox metadata and
// reserves result capacity before sending a ticket. The generated metadata-stage
// registers retain its fields; ticket buffering breaks backward readiness.
// Raw responses cross a retained boundary before reconstruction and execution.
// One reserved activation holds raw RAM responses without duplicating actor metadata.
struct SharedOperands {
  valid: bool,
  ticket: SharedDispatchTicket,
  machine: MachineRamReadResp,
  message: MailboxRamReadResp,
@@OPERAND_GATHER_FIELD@@}

proc SharedLoader<INSTANCE_ID: u32, MAILBOX_STRIDE: u32> {
  tickets: chan<SharedDispatchTicket> in;
  requests: chan<SharedExecutorRequest> out;
  ram_read_req_out: chan<MachineRamReadReq> out;
  ram_read_resp_in: chan<MachineRamReadResp> in;
  mailbox_read_req_out: chan<MailboxRamReadReq> out;
  mailbox_read_resp_in: chan<MailboxRamReadResp> in;

@@GATHER_MEMBERS@@
  // Read ports have one owner. The metadata owner retains both write ports.
  config(tickets: chan<SharedDispatchTicket> in,
      requests: chan<SharedExecutorRequest> out,
      ram_read_req_out: chan<MachineRamReadReq> out,
      ram_read_resp_in: chan<MachineRamReadResp> in,
      mailbox_read_req_out: chan<MailboxRamReadReq> out,
      mailbox_read_resp_in: chan<MailboxRamReadResp> in@@GATHER_PARAMETERS@@) {
    (tickets, requests, ram_read_req_out, ram_read_resp_in,
     mailbox_read_req_out, mailbox_read_resp_in@@GATHER_NAMES@@)
  }

  // The identity distinguishes external RAM specializations during legalization.
  init { (INSTANCE_ID, zero!<SharedOperands>()) }

  // Send the prior response only. Independent actors can replace this slot
  // after its request is accepted; reset discards it with the reserved ticket.
  next(state: (u32, SharedOperands)) {
    let ticket = state.1.ticket;
    let machine = state.1.machine;
    let message = state.1.message;
@@OPERAND_GATHER_BIND@@    let request = SharedExecutorRequest {
      slot: ticket.slot,
      machine: @@MACHINE_BITS@@,
      frame: axis::frame_from_bits(message.data),
      received: ticket.received,
      mailbox_index: ticket.mailbox_index,
      order_index: ticket.order_index,
      egress_ready: true,
@@GATHER_FIELDS@@      @@REDUCTION_FIELDS@@
    };
    let _sent = send_if(join(), requests, state.1.valid, request);
    let (tok, ticket, valid) = recv_non_blocking(join(), tickets, zero!<SharedDispatchTicket>());
    let read_state = send_if(tok, ram_read_req_out, valid, machine_read(ticket.slot));
    let read_mail = send_if(tok, mailbox_read_req_out, valid && ticket.received,
      mailbox::read(ticket.slot, ticket.mailbox_index, MAILBOX_STRIDE));
    let (state_done, machine) = recv_if(read_state, ram_read_resp_in, valid, zero!<MachineRamReadResp>());
    let (mail_done, message) = recv_if(read_mail, mailbox_read_resp_in,
      valid && ticket.received, zero!<MailboxRamReadResp>());
@@GATHER_READ@@    let _responses = join(state_done, mail_done@@GATHER_JOIN@@);
    (state.0, SharedOperands { valid, ticket, machine, message, @@OPERAND_GATHER_VALUE@@ })
  }
}

// Retain a reserved ticket before issuing RAM reads. A full stage may replace
// its ticket only after the loader accepts the prior one. Payload stays in RAM.
proc SharedRequestStage {
  input_request: chan<SharedDispatchTicket> in;
  output_request: chan<SharedDispatchTicket> out;

  // The downstream FIFO supplies occupancy-only readiness.
  config(input_request: chan<SharedDispatchTicket> in,
      output_request: chan<SharedDispatchTicket> out) {
    (input_request, output_request)
  }

  // Reset discards any activation retained by this stage.
  init { (false, zero!<SharedDispatchTicket>()) }

  // Receive and send belong to one atomic activation. Independent tokens permit
  // simultaneous transfer; state replacement waits for the held send to finish.
  next(state: (bool, SharedDispatchTicket)) {
    let _sent = send_if(join(), output_request, state.0, state.1);
    let (_, request, valid) = recv_non_blocking(join(), input_request,
      zero!<SharedDispatchTicket>());
    (valid, if valid { request } else { state.1 })
  }
}
