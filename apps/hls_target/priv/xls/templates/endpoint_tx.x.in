import axis;
import hls_bits;
import endpoint_tx_controller as control;

// One source-derived alias serves every binding field with the exact native codec.
type Binding = control::@@BINDING_TYPE@@;

@@INPUTS@@
@@OUTPUTS@@

// Application storage is independent of the source service's controller profile.
pub type Frame = bits[@@FRAME_BITS@@];

// Only cold reset clears these registers; local retirement retains their bits.
pub struct State { controller: control::ClockState, frame: Frame, slot: u8 }

// Outputs describe this edge; state commits once on the endpoint's local clock.
pub struct Tick { state: State, output: Outputs }

// A cold endpoint has neither binding nor publication ownership.
pub fn initial_state() -> State {
  State { controller: control::clock_initial(), frame: Frame:0, slot: u8:0 }
}

// Source admission and every credit/transmit handshake come from the native kernel.
// Cold state reset belongs to the enclosing proc; this helper only gates reset-edge outputs.
fn tick(s: State, io: Inputs) -> Tick {
  let input = control::@@INPUT_TYPE@@ {
    op: if io.fence { @@FENCE@@ } else if io.bind_request { @@BIND@@ } else { @@TICK@@ },
    binding: Binding {
      namespace: io.namespace, generation: io.generation,
      source_incarnation: io.source_incarnation, destination_incarnation: io.destination_incarnation,
    },
    receiver_binding: Binding {
      namespace: io.receiver_namespace, generation: io.receiver_generation,
      source_incarnation: io.receiver_source_incarnation,
      destination_incarnation: io.receiver_destination_incarnation,
    },
    receiver_active: io.receiver_active,
    local_ready: io.local_ready, local_incarnation: io.local_incarnation,
    source_valid: io.source_valid, data_tx_ready: io.data_tx_ready, credit_valid: io.credit_valid,
    credit_packet: control::@@PACKET_TYPE@@ {
      binding: Binding {
        namespace: io.credit_namespace, generation: io.credit_generation,
        source_incarnation: io.credit_source_incarnation,
        destination_incarnation: io.credit_destination_incarnation,
      },
      sequence: io.credit_sequence,
    },
  };
  let result = control::clock_step(s.controller,
    axis::pack(control::Tag::@@INPUT_TAG@@ as u8,
      hls_bits::frame_payload(control::bits_from_@@INPUT_CODEC@@(input))));
  let observed = control::@@OUTPUT_CODEC@@_from_bits(result.response.payload);
  let retained = result.state.data.channel;
  let live = !io.reset && result.state.failure == u32:0;
  let take = live && observed.source_take;
  Tick {
    // The proc's physical reset pin restores init state. Repeating that reset
    // here creates a second next-value choice and masks every payload data bit.
    // The mechanical wrapper connects the same reset to this input and the proc.
    state: State { controller: result.state,
        frame: if take { io.source_frame } else { s.frame },
        slot: if take { io.source_slot } else { s.slot } },
    output: Outputs {
      source_ready: take, source_take: take, tx_valid: live && observed.tx_valid,
      tx_namespace: observed.packet.binding.namespace,
      tx_generation: observed.packet.binding.generation,
      tx_source_incarnation: observed.packet.binding.source_incarnation,
      tx_destination_incarnation: observed.packet.binding.destination_incarnation,
      tx_sequence: observed.packet.sequence, tx_slot: s.slot, tx_frame: s.frame,
      credit_ready: live && observed.credit_ready, credit_drop: live && observed.credit_drop,
      bound_namespace: retained.binding.namespace, bound_generation: retained.binding.generation,
      bound_source_incarnation: retained.binding.source_incarnation,
      bound_destination_incarnation: retained.binding.destination_incarnation,
      packet_sequence: retained.sequence, status: observed.status,
      active: live && retained.active, fault: !io.reset && result.state.failure != u32:0,
      failure: if io.reset { u32:0 } else { result.state.failure },
    },
  }
}

// One sampled edge belongs only to this source role's local clock.
pub proc endpoint_tx_clock {
  commands: chan<Inputs> in;
  observations: chan<Outputs> out;
  // The stateless pin adapter permanently enables both sampled channels.
  config(commands: chan<Inputs> in, observations: chan<Outputs> out) { (commands, observations) }
  // Initialization follows the same source service as an explicit cold reset.
  init { initial_state() }
  // Local readiness/incarnation changes invoke retirement without resetting payload storage.
  next(s: State) {
    let (tok, io) = recv(join(), commands);
    let result = tick(s, io);
    let _sent = send(tok, observations, result.output);
    result.state
  }
}
